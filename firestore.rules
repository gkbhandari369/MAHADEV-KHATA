rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // staff/{uid} document भएको र active != false भएको मान्छे मात्र
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('active', true) == true;
    }

    // आफ्नो staff document पढ्न मिल्छ (नाम थाहा पाउन); कसैले लेख्न मिल्दैन — Console बाट मात्र
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // हरेक रेकर्ड। लेख्दा 'by' मा आफ्नै uid हुनैपर्छ (अर्काको नाममा लेख्न नमिल्ने)
    match /recs/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.by == request.auth.uid;
      allow delete: if isStaff();
    }

    match /photos/{id}  { allow read, write: if isStaff(); }
    match /backups/{id} { allow read, write: if isStaff(); }

    // पुरानो डेटा — पढ्न मात्र (सुरक्षित कपीको रूपमा रहन्छ, नमेट्नुहोस्)
    match /khata/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
